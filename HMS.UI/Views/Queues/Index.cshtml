@model HMS.UI.Models.DashboardViewModel
@{
    ViewData["Title"] = "Queues";
}

<div class="page-content">
    <div class="portal-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="mb-1 fw-bold">Role Queues</h2>
                <p class="mb-0 text-muted">Jump into the worklist that matches your role.</p>
            </div>
            <a href="/Account/Dashboard" class="btn btn-outline-primary">Back to Dashboard</a>
        </div>
    </div>

    <partial name="_DashboardCardGrid" model="Model.QueueCards" />
</div>
