    @model HMS.UI.Models.Roles.RoleListItemViewModel[]
    @{
        
        ViewData["Title"] = "Roles";
    }

    <div class="container py-4">
        <h3>Roles</h3>
        <p><a class="btn btn-primary" href="/Roles/Create">Create role</a></p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Permissions</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span>@r.Name</span>
                                @if (r.IsSystem)
                                {
                                    <span class="badge-soft-secondary">System</span>
                                }
                            </div>
                        </td>
                        <td>@r.Description</td>
                        <td>@string.Join(", ", r.Permissions)</td>
                        <td>
                            @if (r.IsSystem)
                            {
                                <span class="text-muted small">Locked</span>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-secondary" href="/Roles/Edit/@r.Id">Edit</a>
                                <form method="post" action="/Roles/Delete/@r.Id" style="display:inline" onsubmit="return confirm('Delete role?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
