@model HMS.UI.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var roles = Model.Roles ?? Array.Empty<string>();
    var isBootstrap = string.Equals(Model.DeploymentMode, "Bootstrap", StringComparison.OrdinalIgnoreCase);
    var canRefreshPermissions = isBootstrap && Model.IsDevelopment;
}

<div class="page-content">
    <div class="portal-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="mb-1 fw-bold">
                    Welcome back,
                    <span class="text-primary">@Model.DisplayName</span>
                </h2>

                @if (!string.IsNullOrWhiteSpace(Model.TenantName))
                {
                    <p class="mb-0 text-muted">
                        <i class="bi bi-hospital me-1"></i>
                        @Model.TenantName
                    </p>
                }
            </div>

            <div class="d-flex flex-column align-items-md-end gap-2">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                    @foreach (var role in roles)
                    {
                        <span class="badge-soft-primary">@role</span>
                    }
                </div>

                <form method="post" asp-controller="Account" asp-action="Logout">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (isBootstrap)
    {
        <div class="portal-card mb-4 border-warning">
            <div class="portal-card-header bg-warning-subtle text-warning-emphasis">
                <i class="bi bi-hammer me-2"></i>
                Bootstrap setup checklist
            </div>
            <div class="portal-card-body">
                <div class="row g-3">
                    <div class="col-12 col-lg-8">
                        <ul class="mb-0 ps-3">
                            <li>Set the central platform host list in <a href="/Admin/AppSettings">Application Settings</a>.</li>
                            <li>Confirm `System:DeploymentMode` stays on `Bootstrap` until setup is complete.</li>
                            <li>Run the dev-only permission seed if your database predates the latest roles and permissions.</li>
                            <li>Verify the system admin account can see <strong>System Maintenance</strong> after sign-in.</li>
                            <li>Switch to `Online` when the platform host and tenant routing are ready.</li>
                        </ul>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-primary" href="/Admin/AppSettings">Open App Settings</a>
                            <a class="btn btn-outline-secondary" href="/SystemMaintenance">Open Maintenance</a>
                            @if (canRefreshPermissions)
                            {
                                <form method="post" asp-controller="Account" asp-action="RefreshPermissionCatalog" class="d-grid">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-arrow-repeat me-2"></i>
                                        Refresh permissions
                                    </button>
                                </form>
                            }
                        </div>
                        @if (canRefreshPermissions)
                        {
                            <p class="small text-muted mb-0 mt-2">
                                Development only. Use this when the auth database predates the current built-in permission catalog.
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="portal-card h-100">
                <div class="portal-card-header">
                    <i class="bi bi-person-badge me-2"></i>
                    Your workspace
                </div>
                <div class="portal-card-body">
                    <partial name="_DashboardCardGrid" model="Model.RoleCards" />
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="portal-card h-100">
                <div class="portal-card-header">
                    <i class="bi bi-lightning-charge me-2"></i>
                    Fast actions
                </div>
                <div class="portal-card-body">
                    <div class="row g-3">
                        @foreach (var action in Model.QuickActions)
                        {
                            <div class="col-12">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="module-icon bg-primary-subtle text-primary">
                                                <i class="@action.IconClass"></i>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(action.BadgeText))
                                            {
                                                <span class="@action.BadgeClass">@action.BadgeText</span>
                                            }
                                        </div>
                                        <h6 class="mt-3 mb-1">@action.Title</h6>
                                        <p class="small text-muted mb-3">@action.Description</p>
                                        <a class="btn btn-sm btn-primary-custom text-white" href="@action.LinkUrl">@action.LinkText</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="portal-card mb-4">
        <div class="portal-card-header">
            <i class="bi bi-list-task me-2"></i>
            Active queues
        </div>
        <div class="portal-card-body">
            <partial name="_DashboardCardGrid" model="Model.QueueCards" />
        </div>
    </div>
</div>
